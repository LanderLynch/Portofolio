# AI Engineering Team environment template.
# Copy to .env and fill in local values only.

# Working directories (relative to repository root)
AI_TEAM_PROJECTS_DIR=projects
AI_TEAM_ARTIFACTS_DIR=artifacts
AI_TEAM_LOGS_DIR=logs

# Orchestrator behavior
AI_TEAM_MAX_QA_ROUNDS=3
AI_TEAM_MAX_SECURITY_ROUNDS=3
AI_TEAM_MAX_RETRIES=2

# Logging
AI_TEAM_LOG_LEVEL=info
